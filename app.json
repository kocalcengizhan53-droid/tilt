{
  "expo": {
    "name": "Tilt",
    "slug": "tilt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tilt",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "dev.kocal.tilt",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12052A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.kocal.tilt"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "Tilt — an offline neon arcade",
      "description": "Six arcade games in one offline app, drawn with Skia and Reanimated: Stack, Orbit, Breakout, Slide, Trace and Simon.",
      "themeColor": "#0b0414"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0414",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#0b0414",
            "image": "./assets/images/splash-blank.png"
          }
        }
      ],
      "expo-audio",
      "expo-sqlite",
      "expo-status-bar",
      "expo-asset",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0b0414"
  }
}
